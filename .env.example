# MQTT gateway
MQTT_GATEWAY_USERNAME=gateway
MQTT_GATEWAY_PASSWORD=replace_with_gateway_password

# MQTT publisher
MQTT_PUBLISHER_USERNAME=publisher
MQTT_PUBLISHER_PASSWORD=replace_with_publisher_password

# Local development CA certificate
MQTT_CA_CERT=secrets/mosquitto/ca.crt

# Integration tests
# Use the same passwords as the gateway and publisher above.
MQTT_TEST_GATEWAY_PASSWORD=replace_with_gateway_password
MQTT_TEST_PUBLISHER_PASSWORD=replace_with_publisher_password
